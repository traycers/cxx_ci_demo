{
    "name": "project_c (main, debug)",
    "image": "cxxci-main-dev:latest",

    // Verified live (main-track-package-variants-devcontainer map, ticket 07): as the non-root
    // `vscode` user, SYS_PTRACE only covers ptrace of a process's own descendants (Yama
    // ptrace_scope=1's default allowance) — enough for launch.json's "request": "launch" below,
    // which forks the target itself. It does NOT let `vscode` PTRACE_ATTACH to an already-running
    // sibling process (Docker doesn't propagate --cap-add into a non-root PID1's effective/
    // ambient capability set on this host) — not needed here, but a real limit if attach-mode
    // debugging is ever added.
    "runArgs": [
        "--cap-add=SYS_PTRACE",
        "--security-opt", "seccomp=unconfined"
    ],
    "updateRemoteUserUID": true,
    "remoteUser": "vscode",

    // See project_a/.devcontainer/devcontainer.json for the full rationale: debug.json/
    // relwithdebinfo.json compute CMAKE_INSTALL_PREFIX/CMAKE_PREFIX_PATH themselves as
    // "${sourceParentDir}/_deps/<BuildType>" — no env var needed. Mounting the volume at the
    // /workspaces/_deps parent (not just .../Debug) is what makes both build types land in the
    // same shared volume, required for the artifact chain across sibling devcontainers.
    // CMAKE_TOOLCHAIN_FILE_DEBUG/_RELWITHDEBINFO are deliberately left unset here (no Conan/vcpkg
    // in this devcontainer).
    "mounts": [
        "source=cxxci-main-debug-install,target=/workspaces/_deps,type=volume"
    ],

    "customizations": {
        "vscode": {
            "extensions": [
                "mikestead.dotenv",
                "usernamehw.errorl",
                "earshinov.filter-lines",
                "pkief.material-icon-theme",
                "llvm-vs-code-extensions.vscode-clangd",
                "vadimcn.vscode-lldb",
                "ms-vscode.cmake-tools",
                "akiramiyakoda.cppincludeguard",
                "ajshort.include-autocomplete",
                "danielpinto8zz6.c-cpp-compile-run",
                "xaver.clang-format"
            ]
        }
    }
}
