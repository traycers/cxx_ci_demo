{
    "version": 6,
    "include": [
        "../debug.json"
    ],
    "configurePresets": [
        {
            "name": "debug-asan",
            "inherits": "debug",
            "binaryDir": "${sourceDir}/build/Debug/asan",
            "cacheVariables": {
                "ENABLE_ASAN": "ON"
            }
        },
        {
            "name": "debug-asan-devcontainer",
            "inherits": "debug-asan",
            "condition": {
                "type": "notEquals",
                "lhs": "$env{CMAKE_INSTALL_PREFIX}",
                "rhs": ""
            },
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "$env{CMAKE_INSTALL_PREFIX}"
            }
        }
    ]
}
