{
    "name": "project_a (main, debug)",
    "image": "cxxci-main-dev:latest",

    // Verified live (main-track-package-variants-devcontainer map, ticket 07): as the non-root
    // `vscode` user, SYS_PTRACE only covers ptrace of a process's own descendants (Yama
    // ptrace_scope=1's default allowance) — enough for launch.json's "request": "launch" below,
    // which forks the target itself. It does NOT let `vscode` PTRACE_ATTACH to an already-running
    // sibling process (Docker doesn't propagate --cap-add into a non-root PID1's effective/
    // ambient capability set on this host) — not needed here, but a real limit if attach-mode
    // debugging is ever added.
    "runArgs": [
        "--cap-add=SYS_PTRACE",
        "--security-opt", "seccomp=unconfined"
    ],
    "updateRemoteUserUID": true,
    "remoteUser": "vscode",

    // Named volume, not a bind mount — sits alongside the repo checkout in the container's
    // /workspaces/ (one level above it, matching roadmap.md Phase 1's "install each into a
    // directory at the root of the task directory"), populated by extracting the debug package
    // variant's downloadable archive (Main_Debug_Result — see main-track-package-variants-
    // devcontainer map, ticket 01) into it. debug.json/relwithdebinfo.json compute
    // CMAKE_INSTALL_PREFIX/CMAKE_PREFIX_PATH as "${sourceParentDir}/_deps/<BuildType>" — no env
    // var, no devcontainer-specific knowledge in the presets — which is exactly
    // /workspaces/_deps/Debug or /workspaces/_deps/RelWithDebInfo from inside any of this track's
    // containers, since every project_*/main repo sits at /workspaces/<name> here. Mounting the
    // volume at the /workspaces/_deps parent (not just .../Debug) is what makes both build types
    // resolve into the *same* shared volume — required for the artifact chain (e.g. project_a ->
    // project_c -> project_d) to actually work regardless of which build type is used: whichever
    // project installs into a subdirectory here, every sibling devcontainer mounting this same
    // volume sees it immediately via its own CMAKE_PREFIX_PATH. External deps like GTest come
    // from whatever CMAKE_TOOLCHAIN_FILE_* points at (or, unset here, the apt packages already
    // baked into cxxci-main-dev:latest) — untouched by this mount. CMAKE_TOOLCHAIN_FILE_DEBUG/
    // _RELWITHDEBINFO are deliberately left unset in this devcontainer (no Conan/vcpkg here).
    "mounts": [
        "source=cxxci-main-debug-install,target=/workspaces/_deps,type=volume"
    ],

    "customizations": {
        "vscode": {
            "extensions": [
                "mikestead.dotenv",
                "usernamehw.errorl",
                "earshinov.filter-lines",
                "pkief.material-icon-theme",
                "llvm-vs-code-extensions.vscode-clangd",
                "vadimcn.vscode-lldb",
                "ms-vscode.cmake-tools",
                "akiramiyakoda.cppincludeguard",
                "ajshort.include-autocomplete",
                "danielpinto8zz6.c-cpp-compile-run",
                "xaver.clang-format"
            ]
        }
    }
}
