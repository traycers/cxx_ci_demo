{
    "name": "project_a (main, debug)",
    "image": "cxxci-main-dev:latest",

    // Verified live (main-track-package-variants-devcontainer map, ticket 07): as the non-root
    // `vscode` user, SYS_PTRACE only covers ptrace of a process's own descendants (Yama
    // ptrace_scope=1's default allowance) — enough for launch.json's "request": "launch" below,
    // which forks the target itself. It does NOT let `vscode` PTRACE_ATTACH to an already-running
    // sibling process (Docker doesn't propagate --cap-add into a non-root PID1's effective/
    // ambient capability set on this host) — not needed here, but a real limit if attach-mode
    // debugging is ever added.
    "runArgs": [
        "--cap-add=SYS_PTRACE",
        "--security-opt", "seccomp=unconfined"
    ],
    "updateRemoteUserUID": true,
    "remoteUser": "vscode",

    // Named volume, not a bind mount — sits alongside the repo checkout in the container's
    // /workspaces/ (one level above it, matching roadmap.md Phase 1's "install each into a
    // directory at the root of the task directory"), populated by extracting the debug package
    // variant's downloadable archive (Main_Debug_Result — see main-track-package-variants-
    // devcontainer map, ticket 01) into it. CMAKE_PREFIX_PATH only needs this for the internal
    // artifact-dependency chain (project_c/project_d) — external deps like GTest still come from
    // whatever CMAKE_TOOLCHAIN_FILE_* points at (or, unset here, the apt packages already baked
    // into cxxci-main-dev:latest) — untouched by this mount.
    "mounts": [
        "source=cxxci-main-debug-install,target=/workspaces/_deps/Debug,type=volume"
    ],
    // debug.json/relwithdebinfo.json read CMAKE_INSTALL_PREFIX/CMAKE_PREFIX_PATH (and
    // CMAKE_TOOLCHAIN_FILE) straight from these *_DEBUG / *_RELWITHDEBINFO env vars — the presets
    // themselves carry no devcontainer- or package-manager-specific knowledge, so the same
    // debug/debug-asan/... preset names work here and on a bare host, just with different
    // environment behind them. CMAKE_TOOLCHAIN_FILE_DEBUG is deliberately left unset: this
    // devcontainer doesn't use Conan/vcpkg/etc, see the mounts comment above. CMAKE_PREFIX_PATH:
    // where upstream artifact-dependencies (already unpacked into the volume above) get found by
    // find_package(). CMAKE_INSTALL_PREFIX: where *this* repo's own `cmake --build --target
    // install` writes to — same directory, so installing this repo locally makes it immediately
    // visible to a sibling repo's CMAKE_PREFIX_PATH lookup in another devcontainer sharing the
    // volume.
    "containerEnv": {
        "CMAKE_PREFIX_PATH_DEBUG": "/workspaces/_deps/Debug",
        "CMAKE_INSTALL_PREFIX_DEBUG": "/workspaces/_deps/Debug"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "mikestead.dotenv",
                "usernamehw.errorl",
                "earshinov.filter-lines",
                "pkief.material-icon-theme",
                "llvm-vs-code-extensions.vscode-clangd",
                "vadimcn.vscode-lldb",
                "ms-vscode.cmake-tools",
                "akiramiyakoda.cppincludeguard",
                "ajshort.include-autocomplete",
                "danielpinto8zz6.c-cpp-compile-run",
                "xaver.clang-format"
            ]
        }
    }
}
