FROM cxxci-main:latest

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        clang \
        clangd \
        clang-tidy \
        clang-format \
        git \
        sudo \
    && rm -rf /var/lib/apt/lists/*
# No system lldb/lldb-server here — CodeLLDB (vadimcn.vscode-lldb) bundles its own inside the
# platform-specific VS Code extension VSIX and debugs GCC/DWARF binaries fine (verified: see
# .scratch/main-track-package-variants-devcontainer/research/codelldb-debugger-runtime.md).
# `clang` (not just clangd/clang-tidy/clang-format) is installed alongside the base image's
# build-essential/gcc — project_a's default local dev workflow (taskfile.yml's `debug-asan`
# preset, cmake/presets/configure/debug.json) inherits clang.json and would fail to configure in
# this devcontainer without an actual clang/clang++ compiler present.

# Non-root user for the dev container — devcontainer.json's updateRemoteUserUID remaps this to
# the host user's real uid/gid at container-start time, so file ownership on the bind-mounted
# checkout matches the developer, not this build-time placeholder.
ARG USERNAME=vscode
ARG USER_UID=1000
ARG USER_GID=$USER_UID

# ubuntu:24.04 already ships a pre-created `ubuntu` user/group at uid/gid 1000 — drop it first so
# groupadd/useradd below don't collide with it.
RUN if getent passwd $USER_UID > /dev/null; then userdel -r "$(getent passwd $USER_UID | cut -d: -f1)"; fi \
    && if getent group $USER_GID > /dev/null; then groupdel "$(getent group $USER_GID | cut -d: -f1)"; fi \
    && groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME \
    && echo "$USERNAME ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

USER $USERNAME
