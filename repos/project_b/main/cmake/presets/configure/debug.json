{
    "version": 6,
    "include": ["clang.json"],
    "configurePresets": [
        {
            "name": "debug",
            "hidden": true,
            "inherits": "clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "$env{CMAKE_TOOLCHAIN_FILE_DEBUG}",
                "CMAKE_INSTALL_PREFIX": "${sourceParentDir}/_deps/Debug",
                "CMAKE_PREFIX_PATH": "${sourceParentDir}/_deps/Debug"
            }
        }
    ]
}
