# Copy to .env (gitignored) and fill in real values. docker compose reads .env automatically.

GITLAB_HTTP_PORT=8929
TEAMCITY_HTTP_PORT=8111

# Must be at least 8 chars (GitLab's minimum_password_length floor). Only takes effect on the
# very first boot of an empty gitlab_data volume.
GITLAB_ROOT_PASSWORD=changeme-generate-a-real-one

# Host directory the agent's /opt/buildagent/{work,temp,tools,plugins,system} are bind-mounted
# from — MUST be host bind mounts, not named volumes (docker.sock build steps resolve mount
# sources against the HOST filesystem, see docker-compose.yml's comment on teamcity-agent).
# Defaults to /opt/buildagent, which requires the docker daemon to have write access there —
# true for a normal rootful Docker install, but not for rootless Docker or a host account
# without root. If `docker compose up` fails on these mounts with a permissions error, point
# this at a directory your own user (or the docker daemon) actually owns, e.g.
# BUILDAGENT_DATA_DIR=${HOME}/.local/share/cxxci-buildagent
BUILDAGENT_DATA_DIR=/opt/buildagent
